<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.redx.modsync.HubViewController" prefWidth="800" prefHeight="600">
    
    <!-- Top Header -->
    <top>
        <HBox alignment="CENTER">
            <padding><Insets top="30" bottom="20"/></padding>
            <Label text="My Modpacks" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <!-- Center List Area -->
    <center>
        <VBox spacing="0">
            <padding><Insets top="10" right="60" bottom="20" left="60"/></padding>
            
            <!-- Pseudo-Table Header -->
            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10px 10px 5px 20px; -fx-border-color: transparent transparent #444444 transparent; -fx-border-width: 0 0 1 0;">
                <Label text="Name" style="-fx-text-fill: #aaaaaa; -fx-font-weight: bold; -fx-font-size: 14px;" prefWidth="250"/>
                <Label text="Role" style="-fx-text-fill: #aaaaaa; -fx-font-weight: bold; -fx-font-size: 14px;" prefWidth="100"/>
                <Label text="Mod Count" style="-fx-text-fill: #aaaaaa; -fx-font-weight: bold; -fx-font-size: 14px;" prefWidth="100"/>
                <Label text="Total Size" style="-fx-text-fill: #aaaaaa; -fx-font-weight: bold; -fx-font-size: 14px;" prefWidth="100"/>
            </HBox>

            <!-- The Actual List -->
            <ListView fx:id="modpackList" VBox.vgrow="ALWAYS" />
        </VBox>
    </center>

    <!-- Bottom Action Buttons -->
    <bottom>
        <HBox alignment="CENTER" spacing="40">
            <padding><Insets top="20" right="20" bottom="40" left="20"/></padding>
            
            <Button text="Join Modpack" 
                    style="-fx-background-color: #4a90e2; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 24 12 24;"
                    onAction="#handleJoinModpack"/>
                    
            <Button text="Create Modpack" 
                    style="-fx-background-color: #2e8b57; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 12 24 12 24;"
                    onAction="#handleCreateModpack"/>
        </HBox>
    </bottom>

</BorderPane>