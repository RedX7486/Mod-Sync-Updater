<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.redx.modsync.AdminsViewController" prefWidth="800" prefHeight="600">
    
    <!-- Both Lists -->
    <center>
        <HBox spacing="20">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            
            <VBox HBox.hgrow="ALWAYS" spacing="10">
                <Label text="Pending Uploads (Drag &amp; Drop .jar files here)" 
                       style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                <ListView fx:id="pendingUploadsList" VBox.vgrow="ALWAYS" />
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="10">
                <Label text="Live Server Mods" 
                       style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                <ListView fx:id="serverModsList" VBox.vgrow="ALWAYS" />
            </VBox>
        </HBox>
    </center>

    <!-- Both buttons -->
    <bottom>
        <HBox alignment="CENTER">

            <VBox alignment="CENTER" spacing="10">

                <padding><Insets top="10" right="20" bottom="20" left="20"/></padding>

                <javafx.scene.control.PasswordField fx:id="adminTokenField" alignment="CENTER" 
                                                    promptText="Enter Admin Password..." 
                                                    style="-fx-font-size: 16px; -fx-padding: 8 10 8 10; -fx-pref-width: 250px;"/>

                <Button fx:id="pushChangesButton" 
                        text="Push Changes to Server" 
                        style="-fx-background-color: #2e8b57; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 20 10 20;"
                        onAction="#handlePushChanges"/>

            </VBox>
            
        </HBox>
    </bottom>

</BorderPane>